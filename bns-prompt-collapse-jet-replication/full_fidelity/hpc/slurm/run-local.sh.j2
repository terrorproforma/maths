#!/usr/bin/env bash
set -euo pipefail

: "${BNSJET_STAGE:?Set BNSJET_STAGE to a campaign stage id}"
RUN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$RUN_DIR"
mkdir -p logs checkpoints diagnostics

export OMP_NUM_THREADS={{ scheduler.threads_per_rank }}
{{ scheduler.executable | tojson }} \
    --campaign snapshot/campaign.yaml \
    --stage "$BNSJET_STAGE" \
    --run-directory "$RUN_DIR"
